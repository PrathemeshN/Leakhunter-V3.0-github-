        ES[(Elasticsearch Cluster)]
    end

    subgraph Stealth Scraper Fleet
        TS[Telegram MTProto Workers<br/>Burner Sessions]
        PS[Pastebin Workers<br/>Rotating Proxies]
        FS[Forum Workers<br/>Anti-Detect + CapSolver]
    end
    
    subgraph External APIs
        Proxies[Residential Proxies]
        Captcha[CAPTCHA Solvers]
    end

    FS -.->|Solves Challenges| Captcha
    PS -.->|IP Rotation| Proxies
    FS -.->|IP Rotation| Proxies

    TS -->|Published via AMQP| RMQ
    PS -->|Published via AMQP| RMQ
    FS -->|Published via AMQP| RMQ
    
    RMQ -->|Consumes| Consumer[Consumer Pool<br/>Auto-scaling]
    Consumer -->|Writes| PgBouncer
    PgBouncer --> PG
    Consumer -->|Indexes| ES
    
    UI -->|HTTPS| Nginx
    Nginx --> API
    API -->|Reads| PgBouncer
    API -->|Searches| ES
