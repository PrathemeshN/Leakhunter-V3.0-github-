graph TD
    subgraph Frontend
        UI[React SPA<br/>Cloudflare CDN]
    end

    subgraph Backend Services
        Nginx[Nginx Load Balancer]
        API[FastAPI Cluster<br/>Auto-scaled workers]
    end

    subgraph Message Broker
        RMQ[RabbitMQ Cluster<br/>High Availability]
    end

    subgraph Data Layer
        PgBouncer[PgBouncer<br/>Connection Pooler]
